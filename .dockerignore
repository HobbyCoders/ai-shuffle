tools/stub_upstream/
.stub-upstream-ca/

# OS
.DS_Store
Thumbs.db

# Docker
docker-compose.override.yml
Dockerfile.*

# Logs
*.log
logs/

# Runtime data (user uploads, generated content, databases)
uploads/
generated-images/
data/
*.db

# Root node_modules (tools has its own npm install in Dockerfile)
node_modules/
tools/node_modules/
tools/dist/
browser-mcp/node_modules/
browser-mcp/dist/
.live-monitor/

# Claude config
.claude/

# Android app and account hub: built by their own workflows, never part of the
# server image.
android/

# fluid harness: only fluid/pyproject.toml, fluid/README.md and fluid/fluid are
# needed to pip install it; its tests, docs and benchmarks stay out of the image.
fluid/tests/
fluid/docs/
fluid/benchmarks/

# Frontend build artifacts (rebuilt inside container)
frontend/node_modules/
frontend/build/
frontend/.svelte-kit/
frontend/test-results/
frontend/playwright-report/
frontend/tests/screenshots/
