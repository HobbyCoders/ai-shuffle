uploads/
generated-images/
data/
*.db

# Root node_modules (tools has its own npm install in Dockerfile)
node_modules/
tools/node_modules/
tools/dist/
browser-mcp/node_modules/
browser-mcp/dist/
.live-monitor/

# Claude config
.claude/

# Android app and account hub: built by their own workflows, never part of the
# server image.
android/

# fluid harness: only fluid/pyproject.toml, fluid/README.md and fluid/fluid are
# needed to pip install it; its tests, docs and benchmarks stay out of the image.
fluid/tests/
fluid/docs/
fluid/benchmarks/

# Frontend build artifacts (rebuilt inside container)
frontend/node_modules/
frontend/build/
frontend/.svelte-kit/
frontend/test-results/
frontend/playwright-report/
frontend/tests/screenshots/

# Owner and developer tooling. None of this runs inside the container, and the
# published image is public, so it must never ship. `COPY scripts/` in the
# Dockerfile takes whatever this file leaves in scripts/: keep only the
# in-container maintenance CLIs (credential_keys, rekey, backup, backfills,
# network_migrate).
scripts/unraid-lab/
scripts/ci/
scripts/deploy.sh
scripts/deploy.ps1
scripts/hub_domain_preflight.py
scripts/stage_release.py
scripts/verification_evidence.py
scripts/verify_container_postgres.py
scripts/verify_shared_pg.py
tools/benchmark_sdk_latency.py
tools/ws_*_probe.py
docs/reviews/
docs/audits/
mockups/
videos/
mobile/
redeploy.ps1
Start AI Shuffle.cmd
run_local.*
my-ai-shuffle.xml
LOCAL_SETUP.md
CONTRIBUTING.md
Makefile
pytest.ini
requirements-native.txt
.github/
# requirements-dev.txt stays for now: the Dockerfile installs it as the agent's
# workbench. Dropping it from the customer image is a separate change.
