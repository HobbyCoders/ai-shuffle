#!/bin/sh
# LOCAL-CI-PRE-PUSH v1
# Local checks before anything leaves this machine (scripts/local_ci.py).
# CI does not test pull requests; this hook is where tests run.
# `python scripts/local_ci.py install` copies it into the clone's hooks
# directory and keeps any earlier pre-push hook as pre-push.user.
refs=$(cat)
root=$(git rev-parse --show-toplevel) || exit 1
if [ -f "$root/scripts/local_ci.py" ]; then
  python=""
  # The first interpreter that can run the backend tests wins.
  for candidate in "$LOCAL_CI_PYTHON" python3.12 python3 python "py -3.12"; do
    [ -n "$candidate" ] || continue
    if $candidate -c "import pytest, yaml" >/dev/null 2>&1; then
      python=$candidate
      break
    fi
  done
  if [ -z "$python" ]; then
    echo "pre-push: no Python with pytest and PyYAML found. Install requirements-dev.txt or set LOCAL_CI_PYTHON." >&2
    exit 1
  fi
  printf '%s\n' "$refs" | $python "$root/scripts/local_ci.py" pre-push || exit 1
fi
user_hook="$(dirname "$0")/pre-push.user"
if [ -x "$user_hook" ]; then
  printf '%s\n' "$refs" | "$user_hook" "$@"
  exit $?
fi
exit 0
