{
  "name": "ai-shuffle-frontend",
  "license": "AGPL-3.0-only",
  "version": "1.3.9",
  "private": true,
  "type": "module",
  "overrides": {
    "esbuild": "^0.28.1"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "svelte-kit sync && node scripts/build-mobile-ui.mjs --with-frontend",
    "build:mobile": "node scripts/build-mobile-ui.mjs",
    "postbuild": "node scripts/stamp-sw-version.mjs && node scripts/check-no-mobile-ui.mjs && node scripts/build-mobile-ui.mjs --copy",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && node scripts/check-no-mobile-ui.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "contract:gen": "node scripts/generate-contract.mjs",
    "contract:check": "node scripts/generate-contract.mjs --check",
    "transcript:build": "node scripts/build-transcript-reducer.mjs",
    "transcript:check": "node scripts/build-transcript-reducer.mjs --check",
    "test:visual": "node tests/visual-regression.mjs"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^4.0.1",
    "@sveltejs/kit": "^3.2.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/svelte": "^5.3.1",
    "@types/dompurify": "^3.0.5",
    "@types/node": "^22.9.0",
    "esbuild": "^0.28.1",
    "jsdom": "^27.4.0",
    "json-schema-to-typescript": "^15.0.4",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.0.12",
    "vitest": "^4.1.0"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@tiptap/core": "^3.31.0",
    "@tiptap/extension-placeholder": "^3.15.3",
    "@tiptap/pm": "^3.15.3",
    "@tiptap/starter-kit": "^3.15.3",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "dompurify": "^3.4.17",
    "lucide-svelte": "^0.562.0",
    "marked": "^15.0.0",
    "shiki": "^4.4.3"
  }
}
