{
  "name": "ai-shuffle-frontend",
  "version": "0.8.20",
  "private": true,
  "type": "module",
  "overrides": {
    "cookie": "^0.7.0",
    "esbuild": "^0.28.1"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "svelte-kit sync && vite build",
    "build:mobile": "cd ../mobile && npm run deps && npm run build",
    "sync:mobile": "bash ../android/scripts/sync-mobile-ui.sh",
    "postbuild": "node scripts/stamp-sw-version.mjs && node scripts/check-no-mobile-ui.mjs",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && node scripts/check-no-mobile-ui.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "contract:gen": "node scripts/generate-contract.mjs",
    "contract:check": "node scripts/generate-contract.mjs --check"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.6",
    "@sveltejs/kit": "^2.70.2",
    "@sveltejs/vite-plugin-svelte": "^6.2.2",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/svelte": "^5.3.1",
    "@types/dompurify": "^3.0.5",
    "@types/node": "^22.9.0",
    "jsdom": "^27.4.0",
    "json-schema-to-typescript": "^15.0.4",
    "svelte": "^5.55.9",
    "svelte-check": "^4.3.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.6.3",
    "vite": "^7.3.5",
    "vitest": "^4.1.0"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource/playfair-display": "^5.2.8",
    "@tiptap/core": "^3.31.0",
    "@tiptap/extension-placeholder": "^3.15.3",
    "@tiptap/pm": "^3.15.3",
    "@tiptap/starter-kit": "^3.15.3",
    "dompurify": "^3.4.13",
    "lucide-svelte": "^0.562.0",
    "marked": "^15.0.0",
    "shiki": "^4.4.3"
  }
}
