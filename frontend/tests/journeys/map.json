			"globs": ["frontend/src/lib/components/chat/StopButton*", "frontend/src/lib/components/chat/BackgroundWorkStrip*"]
		},
		{
			"why": "queued (pending) messages",
			"journeys": ["queue-while-busy"],
			"globs": ["frontend/src/lib/components/chat/Pending*", "frontend/src/lib/components/chat/pending-*"]
		},
		{
			"why": "errors and banners shown to the user",
