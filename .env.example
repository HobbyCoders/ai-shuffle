# =============================================================================
# AI Shuffle Configuration
# =============================================================================
# This file works for both Docker and Local deployments.
# Copy to .env and modify as needed.
# =============================================================================

# =============================================================================
# Deployment Mode
# =============================================================================
# Set to "true" to run in local mode (on your PC, not in Docker)
# When true, uses platform-specific paths for data storage
# Leave unset or "false" for Docker deployment
LOCAL_MODE=false

# =============================================================================
# Database (PostgreSQL)
# =============================================================================
# The app builds its own connection URL from these pieces — you never have to
# hand-assemble a postgresql:// string.
#
# POSTGRES_PASSWORD is REQUIRED. Compose fails fast if it is unset — there is
# no insecure default. Generate a strong value, e.g.:
#   openssl rand -base64 32       (bash)
#   [Convert]::ToBase64String((1..24|%{Get-Random -Max 256}))   (PowerShell)
# For local (non-Docker) installs, `python run_local.py --setup` walks you
# through these and writes them here.
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
# Hostname or IP of the Postgres server. Defaults to "postgres" (the bundled
# compose service) in Docker and "localhost" in local mode — only set this if
# your database lives elsewhere.
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_USER=ai_shuffle
# POSTGRES_DB=ai_shuffle
# DB_POOL_MIN=2
# DB_POOL_MAX=10
#
# LEGACY: installs from before the POSTGRES_* split may still have a full
# DATABASE_URL connection string here. It keeps working AND is auto-imported
# into the POSTGRES_* values at startup — a .env with only this variable is a
# fully configured install (Docker included). It still takes precedence at
# connect time over any explicit POSTGRES_* values; remove it once you've
# migrated to the pieces above.
# DATABASE_URL=postgresql://REDACTED@postgres:5432/ai_shuffle

# =============================================================================
# Admin / Encryption
# =============================================================================
# ADMIN_PASSWORD is the master secret. The at-rest encryption key for DB-stored
# API keys is DERIVED from it (PBKDF2 over ADMIN_PASSWORD + a stored salt), so
# changing it requires re-encrypting those secrets. Changing the admin password through the app re-encrypts stored secrets.
# If unset, the key is loaded interactively when an admin logs in; set it here
# for headless/unattended operation (worker install). Use a strong value.
# ADMIN_PASSWORD=CHANGE_ME_STRONG_ADMIN_PASSWORD

# =============================================================================
# Backups (scripts/backup.sh)
# =============================================================================
# Directory backups are written to (created if missing).
# BACKUP_DIR=/data/backups
# Days to keep backups before pruning (default 7).
# BACKUP_RETENTION_DAYS=7

# =============================================================================
# Server Configuration
# =============================================================================
# For Docker: 0.0.0.0 (accessible from host)
# For Local: 127.0.0.1 (localhost only) or 0.0.0.0 (LAN accessible)
HOST=0.0.0.0
PORT=8000

# Service Configuration
SERVICE_NAME=ai-shuffle
LOG_LEVEL=info

# Persistent on-disk logging (survives an app crash + container recreation).
# Rotating file at <DATA_DIR>/logs/<INSTANCE_ID>/app.log plus a native crash
# trace at <DATA_DIR>/logs/<INSTANCE_ID>/fatal.log (previous crash preserved as
# fatal.log.prev). Namespaced per instance so installs sharing a data dir never
# fight over rotation. DATA_DIR is /data (a durable named volume) in Docker and
# %USERPROFILE%\.ai-shuffle on a native Windows install.
# FILE_LOGGING_ENABLED=false  # disable the file handler + faulthandler entirely
# FILE_LOG_LEVEL=INFO         # on-disk level, independent of LOG_LEVEL
# FILE_LOG_MAX_BYTES=10485760 # 10MB per file before rotation
# FILE_LOG_BACKUP_COUNT=5     # number of rotated app.log.N files to keep

# Command Configuration
COMMAND_TIMEOUT=300

# =============================================================================
# Path Configuration
# =============================================================================
# These paths are auto-detected based on deployment mode if not set:
#
# Docker Mode (LOCAL_MODE=false):
#   DATA_DIR=/data
#   WORKSPACE_DIR=/workspace
#
# Local Mode (LOCAL_MODE=true):
#   Windows:  DATA_DIR=%APPDATA%\ai-shuffle
#             WORKSPACE_DIR=%USERPROFILE%\Documents\ai-shuffle-workspace
#   macOS:    DATA_DIR=~/Library/Application Support/ai-shuffle
#             WORKSPACE_DIR=~/ai-shuffle-workspace
#   Linux:    DATA_DIR=~/.local/share/ai-shuffle
#             WORKSPACE_DIR=~/ai-shuffle-workspace
#
# Override with absolute paths if needed:
# DATA_DIR=/custom/path/to/data
# WORKSPACE_DIR=/custom/path/to/workspace

# =============================================================================
# Docker-Only Configuration
# =============================================================================
# User/Group ID Configuration (ignored in local mode)
# For Unraid, use PUID=99 and PGID=100
# For Docker Desktop or standard Linux, use PUID=1000 and PGID=1000
PUID=1000
PGID=1000

# =============================================================================
# Security Configuration
# =============================================================================

# CORS Origins (comma-separated list of allowed origins)
# Use "*" only for development - this disables credential support
# For production, specify your exact domain(s)
# Examples:
#   CORS_ORIGINS=https://yourdomain.com
#   CORS_ORIGINS=https://app.example.com,https://admin.example.com
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Cookie Secure Flag
# Set to true for HTTPS deployments (recommended for production)
# Set to false only for local HTTP development
COOKIE_SECURE=true

# Maximum request body size in MB (default: 50MB)
# Increase if you need to upload larger files
MAX_REQUEST_BODY_MB=50

# Rate Limiting
MAX_LOGIN_ATTEMPTS=5
LOGIN_ATTEMPT_WINDOW_MINUTES=15
LOCKOUT_DURATION_MINUTES=30

# Session expiration
SESSION_EXPIRE_DAYS=30
API_KEY_SESSION_EXPIRE_HOURS=24

# Trusted proxy headers for getting real client IP (comma-separated)
# Common values: X-Forwarded-For, X-Real-IP, CF-Connecting-IP (Cloudflare)
TRUSTED_PROXY_HEADERS=X-Forwarded-For,X-Real-IP

# =============================================================================
# Browser automation (native installs)
# =============================================================================
# The built-in `browser` MCP server drives a local headless Chrome/Edge over a
# loopback DevTools (CDP) port. On native installs the backend auto-launches and
# supervises that browser; in Docker the container image supervises its own
# Chromium instead. These knobs only matter for native installs.
#
# Loopback CDP port the browser listens on and the tools attach to (default 9221)
# CHROME_CDP_PORT=9221
#
# Explicit path to a Chrome/Edge/Chromium binary. Auto-detected from the standard
# Chrome/Edge install locations when unset; set this if yours is elsewhere.
# CHROME_EXECUTABLE=C:\Program Files\Google\Chrome\Application\chrome.exe
#
# (Auto-launch is always on. To drive your own browser instead, just run it on
# the CDP port — if the port already answers, the app won't spawn another.)
#
# Override the browser-mcp entry point (defaults to the packaged Docker path in
# the container, else <repo>/browser-mcp/dist/index.js on native checkouts).
# BROWSER_MCP_ENTRY=/opt/browser-mcp/dist/index.js
#
# Egress policy for the agent's browser. Cloud metadata (169.254.0.0/16) is always
# refused and cannot be re-enabled; LAN and public addresses are always allowed.
#
# Loopback (127.0.0.1 / localhost / ::1) is the exception: allowed by default on
# local installs, refused by default in Docker. Set this to true on a single-user
# self-hosted box so an agent can open a dev server it started itself. Leave it
# off wherever untrusted people can prompt this install — a page the agent visits
# could then reach services on the container's own 127.0.0.1, this app included.
# BROWSER_SSRF_ALLOW_LOOPBACK=true
#
# Explicit CIDR lists. An explicit allow replaces the loopback default above; the
# block list wins over both.
# BROWSER_SSRF_ALLOW=127.0.0.0/8,::1/128
# BROWSER_SSRF_BLOCK=10.0.0.0/8

# =============================================================================
# Authentication Notes
# =============================================================================
# Claude authentication is handled in-app during first-time setup.
# No manual CLI login required — the app guides you through OAuth.
#
# After authenticating, credentials are stored in ~/.claude/.credentials.json
# =============================================================================
