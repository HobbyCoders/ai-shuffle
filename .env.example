# =============================================================================
# AI Shuffle Configuration
# =============================================================================
# This file works for both Docker and Local deployments.
# Copy to .env and modify as needed.
# =============================================================================

# =============================================================================
# Deployment Mode
# =============================================================================
# Set to "true" to run in local mode (on your PC, not in Docker)
# When true, uses platform-specific paths for data storage
# Leave unset or "false" for Docker deployment
LOCAL_MODE=false

# =============================================================================
# Managed database
# =============================================================================
# PostgreSQL is bundled and supervised by the desktop app or Docker runtime.
# No database URL, password, host, port or tuning options are configured here.
# The runtime privately writes DATA_DIR/managed-postgres.json before starting
# the worker. Do not edit, copy into .env, or publish this credential file.
# Preserve the complete data directory and protected backups on upgrades.
# Existing non-managed installations need a separately planned migration;
# this release does not automatically connect to or import their database.
# See docs/RESTORE.md before changing storage.

# =============================================================================
# Credential encryption
# =============================================================================
# Fresh installs create a private random key under DATA_DIR automatically.
# Local/LAN setup needs no account or password. Back up DATA_DIR with the DB;
# see docs/credential-key-recovery.md for encrypted portable recovery exports.
# Legacy migration ONLY: retain the old encryption password for the first
# successful startup/adoption, then remove it. It is no longer a login password
# or runtime dependency. Never replace a missing key by changing this value.
# ADMIN_PASSWORD=EXISTING_LEGACY_ENCRYPTION_PASSWORD

# =============================================================================
# Backups (scripts/backup.sh)
# =============================================================================
# Directory backups are written to (created if missing).
# BACKUP_DIR=/data/backups
# Days to keep backups before pruning (default 7).
# BACKUP_RETENTION_DAYS=7

# =============================================================================
# Server Configuration
# =============================================================================
# For Docker: 0.0.0.0 (accessible from host)
# For Local: 127.0.0.1 (localhost only) or 0.0.0.0 (LAN accessible)
HOST=0.0.0.0
PORT=8000
# Docker only: host interface the app port is published on. Docker-published
# ports bypass host firewall rules, so the default keeps the worker on
# loopback; set 0.0.0.0 (or one LAN address) to expose it on the LAN on purpose.
# BIND_HOST=127.0.0.1

# Service Configuration
SERVICE_NAME=ai-shuffle
LOG_LEVEL=info

# Persistent on-disk logging (survives an app crash + container recreation).
# Rotating file at <DATA_DIR>/logs/<INSTANCE_ID>/app.log plus a native crash
# trace at <DATA_DIR>/logs/<INSTANCE_ID>/fatal.log (previous crash preserved as
# fatal.log.prev). Namespaced per instance so installs sharing a data dir never
# fight over rotation. DATA_DIR is /data (a durable named volume) in Docker and
# %USERPROFILE%\.ai-shuffle on a native Windows install.
# FILE_LOGGING_ENABLED=false  # disable the file handler + faulthandler entirely
# FILE_LOG_LEVEL=INFO         # on-disk level, independent of LOG_LEVEL
# FILE_LOG_MAX_BYTES=10485760 # 10MB per file before rotation
# FILE_LOG_BACKUP_COUNT=5     # number of rotated app.log.N files to keep

# =============================================================================
# Path Configuration
# =============================================================================
# These paths are auto-detected based on deployment mode if not set:
#
# Docker Mode (LOCAL_MODE=false):
#   DATA_DIR=/data
#   WORKSPACE_DIR=/workspace
#
# Local Mode (LOCAL_MODE=true):
#   Windows:  DATA_DIR=%USERPROFILE%\.ai-shuffle
#             WORKSPACE_DIR=%USERPROFILE%\Documents\ai-shuffle-workspace
#   macOS:    DATA_DIR=~/Library/Application Support/ai-shuffle
#             WORKSPACE_DIR=~/ai-shuffle-workspace
#   Linux:    DATA_DIR=~/.local/share/ai-shuffle
#             WORKSPACE_DIR=~/ai-shuffle-workspace
#
# Override with absolute paths if needed:
# DATA_DIR=/custom/path/to/data
# WORKSPACE_DIR=/custom/path/to/workspace

# =============================================================================
# Docker-Only Configuration
# =============================================================================
# User/Group ID Configuration (ignored in local mode)
# For Unraid, use PUID=99 and PGID=100
# For Docker Desktop or standard Linux, use PUID=1000 and PGID=1000
PUID=1000
PGID=1000

# =============================================================================
# Security Configuration
# =============================================================================

# CORS Origins (comma-separated list of allowed origins)
# Use "*" only for development - this disables credential support
# For production, specify your exact domain(s)
# Examples:
#   CORS_ORIGINS=https://yourdomain.com
#   CORS_ORIGINS=https://app.example.com,https://admin.example.com
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Cookie Secure Flag
# Set to true for HTTPS deployments (recommended for production)
# Set to false only for local HTTP development
COOKIE_SECURE=true

# Maximum request body size in MB (default: 50MB)
# Increase if you need to upload larger files
MAX_REQUEST_BODY_MB=50

# Session expiration
SESSION_EXPIRE_DAYS=30

# Trusted proxy headers for getting real client IP (comma-separated)
# Common values: X-Forwarded-For, X-Real-IP, CF-Connecting-IP (Cloudflare)
TRUSTED_PROXY_HEADERS=X-Forwarded-For,X-Real-IP

# Reverse proxies whose headers above are believed (comma-separated IPs or
# CIDRs). Loopback is always trusted. Leave empty unless a proxy on another
# host or container (e.g. its Docker network address, 172.18.0.2) fronts this
# worker; otherwise any LAN host could choose the address that rate limits and
# the audit log see.
TRUSTED_PROXIES=

# =============================================================================
# Browser automation (native installs)
# =============================================================================
# The built-in `browser` MCP server drives a local headless Chrome/Edge over a
# loopback DevTools (CDP) port. On native installs the backend auto-launches and
# supervises that browser; in Docker the container image supervises its own
# Chromium instead. These knobs only matter for native installs.
#
# Loopback CDP port the browser listens on and the tools attach to (default 9221)
# CHROME_CDP_PORT=9221
#
# Explicit path to a Chrome/Edge/Chromium binary. Auto-detected from the standard
# Chrome/Edge install locations when unset; set this if yours is elsewhere.
# CHROME_EXECUTABLE=C:\Program Files\Google\Chrome\Application\chrome.exe
#
# (Auto-launch is always on. To drive your own browser instead, just run it on
# the CDP port — if the port already answers, the app won't spawn another.)
#
# Override the browser-mcp entry point (defaults to the packaged Docker path in
# the container, else <repo>/browser-mcp/dist/index.js on native checkouts).
# BROWSER_MCP_ENTRY=/opt/browser-mcp/dist/index.js
#
# Egress policy for the agent's browser. Public addresses are allowed. Cloud
# metadata (169.254.0.0/16) is always refused and cannot be re-enabled. Private
# network addresses (10/8, 172.16/12, 192.168/16, 100.64/10 carrier-grade NAT or
# Tailscale, fc00::/7) are refused unless listed in BROWSER_SSRF_ALLOW, so a page
# the agent visits cannot reach your router, NAS or other LAN services.
#
# Loopback (127.0.0.1 / localhost / ::1) is allowed by default, in Docker as well
# as on a native or desktop install, so an agent can open a dev server it started
# itself. Pages the browser visits can then reach other loopback services too. Set
# this to false wherever untrusted people can prompt this install. The app's own
# ports (PORT, the protected listener and the browser's DevTools port) stay
# refused on loopback and LAN addresses either way.
# BROWSER_SSRF_ALLOW_LOOPBACK=false
#
# Explicit CIDR lists. An explicit allow replaces the loopback default above; list
# each LAN service the agent may browse. The block list wins over both.
# BROWSER_SSRF_ALLOW=127.0.0.0/8,::1/128,192.168.1.20/32
# BROWSER_SSRF_BLOCK=10.0.0.0/8
#
# Extra ports to refuse on every internal address, on top of the app's own.
# BROWSER_SSRF_DENY_PORTS=9000
#
# Where the browser should look when an agent asks for localhost and the browser
# is not on the same machine as the shell (a containerized runner, say). Only
# used after a direct loopback attempt fails. Resolved automatically from this
# host's outbound interface; set it when that guess is wrong.
# BROWSER_LOOPBACK_HOST=172.17.0.5
#
# Wall clock for one browser tool call (seconds, default 30). A page that stops
# answering returns an error to the agent instead of holding the turn open.
# BROWSER_TOOL_TIMEOUT_SECONDS=30

# =============================================================================
# Code-mode sandbox
# =============================================================================
# Agents on the Fluid harness run their work as Python code in a separate
# process (the code-mode kernel). On Linux that process can run inside
# bubblewrap (bwrap): no network, no host files beyond the Python runtime, a
# private /tmp and its own process namespace. The in-process checks stay on as
# a second layer; the sandbox is the trust boundary.
#   auto     (default) use it when bwrap is installed and its self-test
#            (run once at app startup) passes; otherwise log one
#            warning and run without it
#   required never run code without it; every cell fails with the reason
#   off      never use it
# Docker: the image includes bubblewrap, and the shipped compose file and Unraid
# template allow the container to create user namespaces (security_opt
# seccomp=unconfined and apparmor=unconfined, or a custom seccomp profile) and to
# mount its own /proc (systempaths=unconfined); without those, auto falls back.
# Native Linux: install the bubblewrap package.
# Docker Compose: the published compose.yaml passes only what its
# environment: block names, so set it there (this repository's
# docker-compose.yml also loads .env through env_file).
# CODE_MODE_OS_SANDBOX=auto
# Linux: the app blocks same-uid reads of its /proc/<pid>/environ (its secrets);
# true re-allows core dumps and debugger attach at that cost.
# ALLOW_PROCESS_INTROSPECTION=false

# =============================================================================
# Authentication Notes
# =============================================================================
# Claude: run `claude auth login` in the AI Shuffle terminal (Settings >
# Providers > Claude Code CLI > Sign in), or from the host:
#   docker exec -it -u appuser <container> claude auth login
# The Claude Code CLI keeps its own login in its config directory.
# AI Shuffle never stores or refreshes your Claude credentials.
#
# To use an Anthropic API key instead, add it in Settings.
# =============================================================================
