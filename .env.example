# =============================================================================
# AI Shuffle Configuration
# =============================================================================
# This file works for both Docker and Local deployments.
# Copy to .env and modify as needed.
# =============================================================================

# =============================================================================
# Deployment Mode
# =============================================================================
# Set to "true" to run in local mode (on your PC, not in Docker)
# When true, uses platform-specific paths for data storage
# Leave unset or "false" for Docker deployment
LOCAL_MODE=false

# =============================================================================
# Database (PostgreSQL)
# =============================================================================
# REQUIRED. Compose fails fast if POSTGRES_PASSWORD is unset — there is no
# insecure default. Generate a strong value, e.g.:
#   openssl rand -base64 32       (bash)
#   [Convert]::ToBase64String((1..24|%{Get-Random -Max 256}))   (PowerShell)
# The same password must appear in DATABASE_URL below (the app connects with it).
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
DATABASE_URL=postgresql://REDACTED@postgres:5432/ai_shuffle
# DB_POOL_MIN=2
# DB_POOL_MAX=10

# =============================================================================
# Admin / Encryption
# =============================================================================
# ADMIN_PASSWORD is the master secret. The at-rest encryption key for DB-stored
# API keys is DERIVED from it (PBKDF2 over ADMIN_PASSWORD + a stored salt), so
# changing it requires re-encrypting those secrets. See docs/SECURITY_NOTES.md.
# If unset, the key is loaded interactively when an admin logs in; set it here
# for headless/unattended operation (worker install). Use a strong value.
# ADMIN_PASSWORD=CHANGE_ME_STRONG_ADMIN_PASSWORD

# =============================================================================
# Backups (scripts/backup.sh)
# =============================================================================
# Directory backups are written to (created if missing).
# BACKUP_DIR=/data/backups
# Days to keep backups before pruning (default 7).
# BACKUP_RETENTION_DAYS=7

# =============================================================================
# Server Configuration
# =============================================================================
# For Docker: 0.0.0.0 (accessible from host)
# For Local: 127.0.0.1 (localhost only) or 0.0.0.0 (LAN accessible)
HOST=0.0.0.0
PORT=8000

# Service Configuration
SERVICE_NAME=ai-shuffle
LOG_LEVEL=info

# Persistent on-disk logging (survives an app crash + container recreation).
# Rotating file at <DATA_DIR>/logs/<INSTANCE_ID>/app.log plus a native crash
# trace at <DATA_DIR>/logs/<INSTANCE_ID>/fatal.log (previous crash preserved as
# fatal.log.prev). Namespaced per instance so installs sharing a data dir never
# fight over rotation. DATA_DIR is /data (a durable named volume) in Docker and
# %USERPROFILE%\.ai-shuffle on a native Windows install.
# FILE_LOGGING_ENABLED=false  # disable the file handler + faulthandler entirely
# FILE_LOG_LEVEL=INFO         # on-disk level, independent of LOG_LEVEL
# FILE_LOG_MAX_BYTES=10485760 # 10MB per file before rotation
# FILE_LOG_BACKUP_COUNT=5     # number of rotated app.log.N files to keep

# Command Configuration
COMMAND_TIMEOUT=300

# =============================================================================
# Path Configuration
# =============================================================================
# These paths are auto-detected based on deployment mode if not set:
#
# Docker Mode (LOCAL_MODE=false):
#   DATA_DIR=/data
#   WORKSPACE_DIR=/workspace
#
# Local Mode (LOCAL_MODE=true):
#   Windows:  DATA_DIR=%APPDATA%\ai-shuffle
#             WORKSPACE_DIR=%USERPROFILE%\Documents\ai-shuffle-workspace
#   macOS:    DATA_DIR=~/Library/Application Support/ai-shuffle
#             WORKSPACE_DIR=~/ai-shuffle-workspace
#   Linux:    DATA_DIR=~/.local/share/ai-shuffle
#             WORKSPACE_DIR=~/ai-shuffle-workspace
#
# Override with absolute paths if needed:
# DATA_DIR=/custom/path/to/data
# WORKSPACE_DIR=/custom/path/to/workspace

# =============================================================================
# Docker-Only Configuration
# =============================================================================
# User/Group ID Configuration (ignored in local mode)
# For Unraid, use PUID=99 and PGID=100
# For Docker Desktop or standard Linux, use PUID=1000 and PGID=1000
PUID=1000
PGID=1000

# =============================================================================
# Security Configuration
# =============================================================================

# CORS Origins (comma-separated list of allowed origins)
# Use "*" only for development - this disables credential support
# For production, specify your exact domain(s)
# Examples:
#   CORS_ORIGINS=https://yourdomain.com
#   CORS_ORIGINS=https://app.example.com,https://admin.example.com
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Cookie Secure Flag
# Set to true for HTTPS deployments (recommended for production)
# Set to false only for local HTTP development
COOKIE_SECURE=true

# Maximum request body size in MB (default: 50MB)
# Increase if you need to upload larger files
MAX_REQUEST_BODY_MB=50

# Rate Limiting
MAX_LOGIN_ATTEMPTS=5
LOGIN_ATTEMPT_WINDOW_MINUTES=15
LOCKOUT_DURATION_MINUTES=30

# Session expiration
SESSION_EXPIRE_DAYS=30
API_KEY_SESSION_EXPIRE_HOURS=24

# Trusted proxy headers for getting real client IP (comma-separated)
# Common values: X-Forwarded-For, X-Real-IP, CF-Connecting-IP (Cloudflare)
TRUSTED_PROXY_HEADERS=X-Forwarded-For,X-Real-IP

# =============================================================================
# Authentication Notes
# =============================================================================
# Claude authentication is handled in-app during first-time setup.
# No manual CLI login required — the app guides you through OAuth.
#
# After authenticating, credentials are stored in ~/.claude/.credentials.json
# =============================================================================
