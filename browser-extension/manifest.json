{
  "manifest_version": 3,
  "name": "AI Shuffle",
  "short_name": "AI Shuffle",
  "version": "0.1.0",
  "description": "Chat with your AI Shuffle agents in a side panel and let them work in this browser, inside a tab group for each chat.",
  "minimum_chrome_version": "125",
  "permissions": ["debugger", "tabs", "tabGroups", "storage", "identity", "alarms", "sidePanel"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "side_panel": { "default_path": "sidepanel.html" },
  "action": {
    "default_title": "AI Shuffle",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" }
  },
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
}
