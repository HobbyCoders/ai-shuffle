{
  "name": "ai-shuffle-desktop",
  "version": "0.8.5",
  "private": true,
  "description": "AI Shuffle desktop app: a native window around the web UI of any AI Shuffle worker",
  "author": "HobbyCoders",
  "license": "MIT",
  "homepage": "https://github.com/HobbyCoders/ai-shuffle",
  "repository": {
    "type": "git",
    "url": "https://github.com/HobbyCoders/ai-shuffle.git",
    "directory": "desktop"
  },
  "main": "dist/main/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:worker": "node scripts/build-worker.mjs",
    "build:worker:stub": "node scripts/build-worker.mjs --stub",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "npm run build && electron .",
    "test": "npm run build && node --test \"test/**/*.test.mjs\"",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder --publish never"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "typescript": "^5.6.3"
  }
}
